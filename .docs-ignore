# Read by plugins/canopy/skills/doc-regeneration/scripts/check_refs.py and find_history.py.
# Format and matching rules: plugins/canopy/skills/doc-regeneration/scripts/docs_ignore.py.
# Every entry carries its reason after ' # '; tests/test_docs_ignore.py fails on an entry
# nothing matches, so this file cannot outlive what it excuses.

# --- check_refs: files that live in another repo, named where they are explained ---
check_refs packages/canopy_kb                         # canopy-web's knowledge-base package
check_refs docs/architecture/roles.md                 # canopy-web's roles page
check_refs docs/architecture/access.md                # canopy-web's access page
check_refs docs/vault/zk-v1/zk_v1_reference.py        # canopy-web's zero-knowledge reference implementation
check_refs hooks/gating_guard.py                      # hal's copy of the gating engine, named as a historical lineage row

# --- find_history: the regen skill quotes the patterns it teaches people to remove ---
find_history plugins/canopy/skills/doc-regeneration/SKILL.md::History is wasted context  # lists example history phrases
find_history plugins/canopy/skills/doc-regeneration/SKILL.md::flags ISO dates  # names what the script flags
find_history plugins/canopy/skills/doc-regeneration/SKILL.md::Check 2  # names the history categories
find_history plugins/canopy/skills/doc-regeneration/SKILL.md::History guard  # quotes the guard's trigger
